{
  "opencollection": "1.0.0",
  "info": {
    "name": "Nango Actions Integrations API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Integrations",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List integrations",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.nango.dev/integrations"
          },
          "docs": "List integrations"
        },
        {
          "info": {
            "name": "Create an integration",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.nango.dev/integrations",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create an integration"
        },
        {
          "info": {
            "name": "Get an integration",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.nango.dev/integrations/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get an integration"
        },
        {
          "info": {
            "name": "Update an integration",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://api.nango.dev/integrations/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update an integration"
        },
        {
          "info": {
            "name": "Delete an integration",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.nango.dev/integrations/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Delete an integration"
        }
      ]
    }
  ],
  "bundled": true
}